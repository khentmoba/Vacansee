{
  "buildCommand": "cd landing && npm install && npm run build",
  "outputDirectory": "landing/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/app/(.*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}